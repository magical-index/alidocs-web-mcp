{
  "name": "@magical-index/alidocs-web-mcp",
  "version": "0.1.1",
  "description": "Local MCP bridge that exposes the DingTalk Doc (alidocs) page already open in your browser to any MCP host over stdio.",
  "license": "MIT",
  "author": "nitonitori <li.gb@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magical-index/alidocs-web-mcp.git"
  },
  "homepage": "https://github.com/magical-index/alidocs-web-mcp#readme",
  "bugs": {
    "url": "https://github.com/magical-index/alidocs-web-mcp/issues"
  },
  "type": "module",
  "bin": {
    "alidocs-web-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "AGENT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/protocol',{recursive:true});fs.copyFileSync('src/protocol/vectors.json','dist/protocol/vectors.json')\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run check:package",
    "start": "node ./dist/cli.js",
    "start:write": "node ./dist/cli.js --allow-write",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dingtalk",
    "alidocs",
    "websocket-bridge",
    "ai-agent",
    "document-editing"
  ],
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.20.1",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./protocol/crypto": {
      "types": "./dist/protocol/crypto.d.ts",
      "default": "./dist/protocol/crypto.js"
    },
    "./protocol/vectors.json": "./dist/protocol/vectors.json",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts"
}
